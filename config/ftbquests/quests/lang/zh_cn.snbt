{
	chapter.04EC7DE434D9E8A8.title: "酸与碱"
	chapter.2BB2EDF78B0A21A0.title: "最初的指引"
	chapter.5BC220669731F7A2.title: "铁与铜"
	chapter.77D37C9A00BB2C6E.title: "热与电"
	chapter_group.0B40A5B128118B9B.title: "主线"
	quest.106CEFFCECA19FA2.quest_desc: [
		"普通的粉碎机，把矿物锭磨成粉末。"
		""
		"需要耗电，可以参看【热与电】章节。"
		""
		"&9提示&r：没有红石就做不出电线，而红石又需要这个？其实直接把发电机和耗电的机器贴在一起就可以工作了，不需要线。"
	]
	quest.118E7F48ABDF13C5.quest_desc: [
		"&7&o是时候打开下一个时代的大门了。&r"
		""
		"青铜是制作各类管道的重要工具。它解锁了处理液体和气体的能力，也方便了电力传导、物流运输。"
		""
		"将铜锭和不纯的锡锭投入岩浆，就可以合金成青铜了。"
	]
	quest.1380ADCDC79DE7BC.quest_desc: [
		"&9前置条件&r：完成【铁与铜】章节中，生产铁锭和铜锭的部分。推荐将其自动化。"
		""
		"本章介绍了产电和产热的方法。"
		""
		"从前期到后期的内容都包含在其中，请根据当前手头的资源和产线情况自由选择。"
	]
	quest.1380ADCDC79DE7BC.title: "热与电"
	quest.16FE7470686B8704.quest_desc: [
		"圆石也可以产生熔岩。"
		""
		"只要放进&9热力熔炼炉&r，并且施加&a1000&r摄氏度的高温就可以了。"
	]
	quest.17EFAB87461C0523.quest_desc: [
		"要说砸的话，铁砧自然比圆石更重，锻打效果也更好。"
		""
		"一个铁砧可以将一个海绵铁砸成&26个&r铁锭。"
		""
		"&9提示&r：别忘了铁砧也会损坏。"
		""
		"铁砧每次下落时，有5%乘以摔落高度的概率恶化一个等级，但是只下落 1 格时&2不会损坏&r。"
		""
		"铁砧下落太高的话，额外砸出的铁锭有可能还不够补充铁砧哦。"
	]
	quest.17EFAB87461C0523.title: "如何砸得更狠？"
	quest.18A3F62F1EDD8BE5.quest_desc: [
		"锻打海绵铁最简单的方式，当然是&3砸&r！"
		""
		"用圆石砸中掉落物形式的海绵铁，就可以将它转化为铁锭。"
		""
		"&c注意&r：圆石本身&c不能摔碎&r。"
	]
	quest.18DF74D1DDC08ACB.quest_desc: [
		"烧炼铜时并不会出现和铁一样的问题。"
		""
		"直接放入熔炉，就可以获得铜锭了。"
	]
	quest.1D951836E2DAC331.quest_desc: [
		"二氧化锡中通常含有很多铁杂质。"
		""
		"然而，如果只是要炼制青铜，即使是不纯的锡锭也足够了。"
	]
	quest.1F179DBE3C3629CC.quest_desc: ["你知道的，哪里都要用到熔岩。"]
	quest.34AF1C317D3F6708.quest_desc: [
		"&9前置条件&r："
		"- 完成【铁与铜】，获得青铜；"
		"- 发展【热与电】，能够供热即可。本章不耗电。"
	]
	quest.34AF1C317D3F6708.title: "酸与碱"
	quest.369A0995C4B07D0D.quest_desc: [
		"既可以发电又可以发热。"
		""
		"将七面（本体也算）浸入岩浆，可以被动发电，也可以主动输入燃料。"
		""
		"如果用导热线缆而不是通用线缆（电线）导出，会转而发热。"
	]
	quest.4653DD8A49440BF4.quest_desc: [
		"圆石中含有不少氧化铁，在粉碎为沙砾的过程中自然可以收集到一些。"
		""
		"摔落时，氧化铁粉的产率是&215%&r。"
	]
	quest.4653DD8A49440BF4.title: "氧化铁粉"
	quest.48395807EC9FDBC1.quest_desc: [
		"氧化铁直接与木炭反应生成的铁含有大量杂质和空缺，是脆的。它被称作海绵铁。"
		""
		"海绵铁还需要锻打成型，才能做出真正的铁锭。"
	]
	quest.48395807EC9FDBC1.title: "海绵铁锭"
	quest.4C48188DBD6E7AD5.quest_desc: ["沙砾在摔碎为沙子的过程中，有&215%&r的概率收集到氧化铜。"]
	quest.5A2BE9DCEBC704B0.quest_desc: [
		"欢迎来到《圆石化学》整合包。这是一个以工业流程为主的整合包，侧重于搭建自动的化工产线。"
		""
		"整合包中的产线纷繁复杂，但只有【主线】章节下的产线是必须制作的。不过，其他产线可以合成许多有用的产物，它们能大幅提高生产效率。"
		""
		"&c注意：&r树苗可以在混凝土上成长。"
	]
	quest.5A2BE9DCEBC704B0.title: "欢迎游玩！"
	quest.5F5BFF9F672327FC.quest_desc: ["导电？只需要铁就可以了。"]
	quest.6076A979EAF2CAA4.quest_desc: ["和获得沙砾的方法一样，继续摔碎沙砾可以得到沙子。"]
	quest.63B1135EF4AA43CB.quest_desc: [
		"摇床是一种会摇的机器，无需通电。"
		""
		"总之，剧烈地摇一会就可以分离出很多东西。"
	]
	quest.68C70533C312F01B.quest_desc: [
		"将沙子以物品形式丢入水中，等待片刻，即可获得黏土。"
		""
		"&9提示&r：这就是 AE2 的世界合成配方。"
	]
	quest.6A74A50426AD51AD.quest_desc: [
		"在两侧放水和岩浆，就可以无限产生圆石。"
		""
		"会自动输出到头顶的箱子里。"
		""
		"此外，在它下方放置某种石质方块，就可以让刷石机产生这种方块，但某些配方会消耗流体源。"
	]
	quest.6A74A50426AD51AD.title: "刷石机"
	quest.6D13DFB37C8F7821.quest_desc: [
		"一切的开端。"
		""
		"岩浆入水，不是水入岩浆。"
	]
	quest.6D13DFB37C8F7821.title: "圆石"
	quest.6D71DBE70EB52C74.quest_desc: [
		"氧化铁粉里会含有一些其他杂质。"
		""
		"我们用水将它们分开。"
	]
	quest.733587355D7DA199.quest_desc: [
		"看起来和&2通用机械&r的电力熔炼炉一样，不过是自定义机器。"
		""
		"它需要600摄氏度来熔炼锡锭，具体请参见【热与电】章节。"
		""
		"&9提示&r：原来的熔炼炉当然无法合成了。如果想要的话，可以考虑铁熔炉系列与RF升级（真的很快！）"
	]
	quest.75002315371A10B6.quest_desc: [
		"红石具有优秀的信号传导功能，外观又是红色，这表明了它其实是铁和铜的合金。"
		""
		"只不过里面似乎混入了一点其他的未知元素。会是什么呢？"
		""
		"&9提示&r：将铁粉和铜粉以物品形式丢入岩浆，稍作等待即可反应出红石。"
		""
		"不必担忧，这些物品不会被岩浆烧毁。"
	]
	quest.75002315371A10B6.title: "红石"
	quest.779582DB227391FE.quest_desc: [
		"&o&7在还没有粉碎机的时代，我们只能&l摔碎&r&o&7它。&r"
		""
		"在放置圆石时，如果下方没有方块，它会像沙子一样掉落。"
		""
		"只要掉落超过4格，它就会摔碎成沙砾，同时也可能摔出副产物。"
		""
		"&c注意：&r只有在&c&l放置&r时才会有效。如果打掉放好的圆石下方的方块，它是不会掉落的。"
	]
	quest.78B0972A28E42F99.quest_desc: ["没什么特别的，烧沙子就可以了。"]
	task.5C1D8A34536CF342.title: "欢迎来到整合包！"
	task.7421345814F1AFB0.title: "酸与碱"
}
